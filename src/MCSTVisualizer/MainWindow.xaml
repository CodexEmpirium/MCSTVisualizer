<Window x:Class="MCSTVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCST Visualizer" Height="900" Width="1360"
        MinHeight="760" MinWidth="1080" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="2,1"/>
            <EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
        </Style>
    </Window.Resources>
    <DockPanel x:Name="RootVisual" Background="#F4F6F9">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open" Click="Open_Click"/>
                <MenuItem Header="_Save" Click="Save_Click"/>
                <MenuItem Header="Save _As" Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Settings" Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Zoom" Click="Zoom_Click"/>
                <MenuItem Header="_Screenshot" Click="Screenshot_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Help" Click="Help_Click"/>
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top" Padding="6">
            <Button ToolTip="Save screenshot" Click="Screenshot_Click">
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="24" Height="18" Margin="0,0,8,0" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle Width="18" Height="13" Canvas.Left="3" Canvas.Top="4" Stroke="#243143" StrokeThickness="1.6" Fill="#FFFFFF" RadiusX="2" RadiusY="2"/>
                        <Rectangle Width="7" Height="3" Canvas.Left="7" Canvas.Top="1" Stroke="#243143" StrokeThickness="1.4" Fill="#FFFFFF"/>
                        <Ellipse Width="6" Height="6" Canvas.Left="9" Canvas.Top="7" Stroke="#243143" StrokeThickness="1.4" Fill="#DDE7F8"/>
                        <Path Data="M20,0 L23,4 L20,4 L23,9" Stroke="#F6B73C" StrokeThickness="1.8"/>
                    </Canvas>
                    <TextBlock Text="Screenshot"/>
                </StackPanel>
            </Button>
            <Button ToolTip="Save parameters as CSV" Click="SaveCsv_Click">
                <StackPanel Orientation="Horizontal">
                    <Canvas Width="24" Height="20" Margin="0,0,8,0" IsHitTestVisible="False" SnapsToDevicePixels="True">
                        <Rectangle Width="15" Height="17" Canvas.Left="2" Canvas.Top="1" Stroke="#243143" StrokeThickness="1.4" Fill="#FFFFFF" RadiusX="1.5" RadiusY="1.5"/>
                        <Line X1="5" Y1="5" X2="14" Y2="5" Stroke="#96A0AD" StrokeThickness="1"/>
                        <Line X1="5" Y1="8" X2="14" Y2="8" Stroke="#96A0AD" StrokeThickness="1"/>
                        <Path Data="M8,15 L16,7 L19,10 L11,18 Z" Fill="#415A77"/>
                        <Ellipse Width="9" Height="9" Canvas.Left="14" Canvas.Top="10" Fill="#2F9E44"/>
                        <Path Data="M16,12 L21,17 M21,12 L16,17" Stroke="#FFFFFF" StrokeThickness="1.6"/>
                    </Canvas>
                    <TextBlock Text="Save CSV"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem x:Name="StatusText" Content="Ready"/>
        </StatusBar>

        <TabControl Margin="12" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="2D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Plane Axes" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="First axis"/>
                                    <ComboBox x:Name="Axis1Box" IsEditable="True" SelectionChanged="AxisChanged" LostFocus="AxisLostFocus">
                                        <ComboBoxItem Content="x" IsSelected="True"/>
                                        <ComboBoxItem Content="y"/>
                                        <ComboBoxItem Content="z"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Second axis"/>
                                    <ComboBox x:Name="Axis2Box" IsEditable="True" SelectionChanged="AxisChanged" LostFocus="AxisLostFocus">
                                        <ComboBoxItem Content="x"/>
                                        <ComboBoxItem Content="y" IsSelected="True"/>
                                        <ComboBoxItem Content="z"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="StressValuesHeader" Text="Stress Values (GPa)" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <TextBlock Text="Display units"/>
                            <ComboBox x:Name="StressUnitBox" SelectionChanged="StressUnitBox_SelectionChanged">
                                <ComboBoxItem Content="psi"/>
                                <ComboBoxItem Content="ksi"/>
                                <ComboBoxItem Content="kPa"/>
                                <ComboBoxItem Content="MPa" IsSelected="True"/>
                                <ComboBoxItem Content="GPa"/>
                            </ComboBox>
                            <TextBlock x:Name="SigmaXLabel" Text="sigma_x"/>
                            <TextBox x:Name="SigmaXBox" TextChanged="ValueBox_TextChanged"/>
                            <TextBlock x:Name="SigmaYLabel" Text="sigma_y"/>
                            <TextBox x:Name="SigmaYBox" TextChanged="ValueBox_TextChanged"/>
                            <TextBlock x:Name="TauXYLabel" Text="tau_xy"/>
                            <TextBox x:Name="TauXYBox" TextChanged="ValueBox_TextChanged"/>
                            <TextBlock x:Name="SigmaAveLabel" Text="sigma_ave"/>
                            <TextBox x:Name="SigmaAveBox" TextChanged="ValueBox_TextChanged"/>
                            <TextBlock Text="R"/>
                            <TextBox x:Name="RadiusBox" TextChanged="ValueBox_TextChanged"/>
                            <TextBlock x:Name="TauMaxLabel" Text="tau_max"/>
                            <TextBox x:Name="TauMaxBox" TextChanged="ValueBox_TextChanged"/>
                            <Separator Margin="0,8"/>
                            <TextBlock x:Name="ThetaLabel" Text="theta, degrees"/>
                            <TextBox x:Name="ThetaBox" TextChanged="ValueBox_TextChanged"/>
                            <TextBlock x:Name="DerivedText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D5DCE7" BorderThickness="1" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock Text="Mohr's Circle" FontSize="18" FontWeight="SemiBold" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Canvas x:Name="MohrCanvas" Background="#FFFFFF" Margin="12,48,12,12"
                                    MouseDown="MohrCanvas_MouseDown" MouseMove="MohrCanvas_MouseMove" MouseUp="Canvas_MouseUp" SizeChanged="Canvas_SizeChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D5DCE7" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Stress Tensor Diagram" FontSize="18" FontWeight="SemiBold" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Canvas x:Name="StressTensorCanvas" Background="#FFFFFF" Margin="12,48,12,12"
                                    MouseDown="StressTensorCanvas_MouseDown" MouseMove="StressTensorCanvas_MouseMove" MouseUp="Canvas_MouseUp" SizeChanged="Canvas_SizeChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="3D">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="Stress3DValuesHeader" Text="3D Stress Tensor (MPa)" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Display units"/>
                            <ComboBox x:Name="Stress3DUnitBox" SelectionChanged="StressUnitBox_SelectionChanged">
                                <ComboBoxItem Content="psi"/>
                                <ComboBoxItem Content="ksi"/>
                                <ComboBoxItem Content="kPa"/>
                                <ComboBoxItem Content="MPa" IsSelected="True"/>
                                <ComboBoxItem Content="GPa"/>
                            </ComboBox>
                            <TextBlock x:Name="Sigma3DXLabel" Text="sigma_x"/>
                            <TextBox x:Name="Sigma3DXBox" TextChanged="Value3DBox_TextChanged"/>
                            <TextBlock x:Name="Sigma3DYLabel" Text="sigma_y"/>
                            <TextBox x:Name="Sigma3DYBox" TextChanged="Value3DBox_TextChanged"/>
                            <TextBlock x:Name="Sigma3DZLabel" Text="sigma_z"/>
                            <TextBox x:Name="Sigma3DZBox" TextChanged="Value3DBox_TextChanged"/>
                            <TextBlock x:Name="Tau3DXYLabel" Text="tau_xy"/>
                            <TextBox x:Name="Tau3DXYBox" TextChanged="Value3DBox_TextChanged"/>
                            <TextBlock x:Name="Tau3DYZLabel" Text="tau_yz"/>
                            <TextBox x:Name="Tau3DYZBox" TextChanged="Value3DBox_TextChanged"/>
                            <TextBlock x:Name="Tau3DZXLabel" Text="tau_zx"/>
                            <TextBox x:Name="Tau3DZXBox" TextChanged="Value3DBox_TextChanged"/>
                            <Separator Margin="0,10"/>
                            <TextBlock Text="Rotation" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock x:Name="RotationXText" Text="X: 0 deg"/>
                            <Slider x:Name="RotationXSlider" Minimum="-180" Maximum="180" TickFrequency="15" IsSnapToTickEnabled="False" ValueChanged="Rotation3D_ValueChanged"/>
                            <TextBlock x:Name="RotationYText" Text="Y: 0 deg"/>
                            <Slider x:Name="RotationYSlider" Minimum="-180" Maximum="180" TickFrequency="15" IsSnapToTickEnabled="False" ValueChanged="Rotation3D_ValueChanged"/>
                            <TextBlock x:Name="RotationZText" Text="Z: 0 deg"/>
                            <Slider x:Name="RotationZSlider" Minimum="-180" Maximum="180" TickFrequency="15" IsSnapToTickEnabled="False" ValueChanged="Rotation3D_ValueChanged"/>
                            <TextBlock x:Name="Derived3DText" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D5DCE7" BorderThickness="1" Margin="0,0,12,0">
                        <Grid>
                            <TextBlock Text="3D Stress Tensor" FontSize="18" FontWeight="SemiBold" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Canvas x:Name="StressTensor3DCanvas" Background="#FFFFFF" Margin="12,48,12,12"
                                    MouseDown="StressTensor3DCanvas_MouseDown"
                                    MouseMove="StressTensor3DCanvas_MouseMove"
                                    MouseUp="StressTensor3DCanvas_MouseUp"
                                    SizeChanged="Canvas3D_SizeChanged"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D5DCE7" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="Mohr's Sphere" FontSize="18" FontWeight="SemiBold" Margin="16" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Canvas x:Name="MohrSphereCanvas" Background="#FFFFFF" Margin="12,48,12,12" SizeChanged="Canvas3D_SizeChanged"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

